<Window x:Class="Lab3_Guselnikova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Lab3_Guselnikova.Converters"
        Title="Список товаров" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Window.Resources>
        <conv:DiscountToBackgroundConverter x:Key="DiscountBg"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Гусельникова Анастасия Витальевна"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,250,0" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Добавить товар" Width="130" Height="26" Margin="0,0,8,0"
                Click="AddProduct_Click"/>
                <Button Content="Выход" Width="80" Height="26" Click="Exit_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" Width="500" Height="26"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Products}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1"
                                Margin="0,0,0,6"
                                Background="{Binding Discount, Converter={StaticResource DiscountBg}}"
                                Tag="{Binding}"
                                MouseLeftButtonUp="Card_Click">
                            <Grid Height="130">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="Black"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="PHOTO" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="Gray"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,5">
                                    <TextBlock>
                                        <Run FontWeight="Bold" Text="{Binding Category.Name, Mode=OneWay}"/>
                                        <Run FontWeight="Bold" Text=" | "/>
                                        <Run FontWeight="Bold" Text="{Binding Article, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description, StringFormat='Описание товара: {0}'}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Manufacturer.Name, StringFormat='Производитель: {0}'}"/>
                                    <TextBlock Text="{Binding Supplier.Name, StringFormat='Поставщик: {0}'}"/>
                                    <TextBlock Foreground="Red"
                                               Text="{Binding Price, StringFormat='Цена: {0:F2}'}"/>
                                    <TextBlock Text="{Binding Unit, StringFormat='Единица измерения: {0}'}"/>
                                    <TextBlock Text="{Binding Count, StringFormat='Количество на складе: {0}'}"/>
                                </StackPanel>

                                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1,0,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Действующая" TextAlignment="Center"/>
                                        <TextBlock Text="скидка" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Discount, StringFormat='{}{0} %'}"
                                                   TextAlignment="Center" FontWeight="Bold" FontSize="18"
                                                   Margin="0,4,0,0"/>
                                        <Button Content="Удалить" Width="90" Margin="0,8,0,0"
                                                Click="Delete_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>